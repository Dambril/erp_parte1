# Environment variables template
# Copy this file to .env.local and fill in real values.
# NEVER commit .env files with real secrets.

# MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.example.mongodb.net/erp?retryWrites=true&w=majority
# Optional: overrides the database name in the URI path (if the URI has none, the driver uses "test")
MONGODB_DB_NAME=erp

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m

# App
NODE_ENV=development
PORT=3000
# Optional: comma-separated web origins allowed by CORS (e.g. https://tssera-erp.pages.dev)
# Empty = any origin in development, none in production.
CORS_ORIGINS=

# Redis (for BullMQ) — optional until background jobs are implemented
REDIS_URL=redis://localhost:6379

# Tenant (for development single-tenant mode)
DEFAULT_TENANT_ID=dev-tenant-001

# Email (Resend) — opcional; sin RESEND_API_KEY los correos solo se registran en el log
# Con el remitente de pruebas (onboarding@resend.dev) Resend solo entrega al correo dueño de la cuenta.
RESEND_API_KEY=
EMAIL_FROM=ERP <onboarding@resend.dev>
# URL pública de la web (obligatoria en producción); los correos enlazan a /restablecer?token=... y /activar?token=...
# Fuera de producción, por defecto http://localhost:5173
APP_WEB_URL=

# Seed (pnpm --filter @erp/api seed): empresa y cuentas iniciales. Contraseñas de 15 a 128 caracteres.
# Para probar invitaciones con tu propio correo, usa aquí correos distintos al tuyo (el correo es único en la plataforma).
SEED_TENANT_ID=
SEED_COMPANY_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=
SEED_ADMIN_PASSWORD=
SEED_USER_EMAIL=
SEED_USER_NAME=
SEED_USER_PASSWORD=
