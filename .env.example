# Plantilla de variables de entorno de la API. Copia este archivo a .env.local (en la raíz del repo) y llénalo.
# Nunca subas archivos .env con valores reales. La tabla completa, con cómo obtener cada valor, está en docs/RUNBOOK.md.

# ── Base de datos (obligatoria) ─────────────────────────────────────────────
# Cadena de conexión de MongoDB Atlas. Si la contraseña tiene caracteres especiales, codifícalos en formato URL.
MONGODB_URI=mongodb+srv://<usuario>:<contraseña>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Opcional. Nombre de la base; si falta se usa el de la URI (o "test").
MONGODB_DB_NAME=erp

# ── Sesiones ────────────────────────────────────────────────────────────────
# Obligatoria. Secreto con el que se firman los access tokens. Genera uno con: openssl rand -base64 48
JWT_SECRET=
# Opcional. Vida del access token (por defecto 15m). El refresh token dura 30 días.
JWT_EXPIRES_IN=15m

# ── Servidor ────────────────────────────────────────────────────────────────
# Opcional. development (por defecto), test o production.
NODE_ENV=development
# Opcional. Puerto de la API (por defecto 3000).
PORT=3000
# Obligatoria. Tenant por defecto de los scripts de mantenimiento.
DEFAULT_TENANT_ID=dev-tenant-001
# Opcional en desarrollo (vacía = cualquier origen); obligatoria en producción para que la web pueda entrar.
# Orígenes de la web separados por comas, sin barra final. Ejemplo: http://localhost:5173,http://192.168.1.50:5173
CORS_ORIGINS=
# Opcional. Solo hará falta cuando existan jobs con BullMQ.
REDIS_URL=redis://localhost:6379

# ── Correo (Resend) ─────────────────────────────────────────────────────────
# Opcional. Sin ella los correos no se envían: solo se anota en el log. Formato: re_xxxxxxxx
RESEND_API_KEY=
# Opcional. Remitente con nombre visible. onboarding@resend.dev es el remitente de pruebas de Resend:
# SOLO entrega al correo del dueño de la cuenta de Resend. Para escribir a otros hay que verificar un dominio.
EMAIL_FROM=T-ssera Construcciones <onboarding@resend.dev>
# Obligatoria en producción; en desarrollo, por defecto http://localhost:5173. URL de la web, sin barra final:
# los correos enlazan a <APP_WEB_URL>/restablecer?token=... y <APP_WEB_URL>/activar?token=...
APP_WEB_URL=http://localhost:5173

# ── Seed (pnpm --filter @erp/api seed y dev:memory) ─────────────────────────
# Empresa y cuentas iniciales. Contraseñas de 15 a 128 caracteres. Son tus credenciales de prueba.
# Para probar invitaciones con tu propio correo, usa aquí correos distintos al tuyo (el correo es único en la plataforma).
SEED_TENANT_ID=
SEED_COMPANY_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=
SEED_ADMIN_PASSWORD=
SEED_USER_EMAIL=
SEED_USER_NAME=
SEED_USER_PASSWORD=
